// Deploys this site to the rq-site Worker (static assets only).
// From this folder: npx wrangler deploy
{
  "name": "rq-site",
  "compatibility_date": "2025-10-08",
  "assets": {
    "directory": ".",
    "not_found_handling": "404-page"
  },
  "routes": [
    { "pattern": "residentquant.com/*", "zone_name": "residentquant.com" },
    { "pattern": "www.residentquant.com/*", "zone_name": "residentquant.com" }
  ],
  "workers_dev": true
}
